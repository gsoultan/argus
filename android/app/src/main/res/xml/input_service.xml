<?xml version="1.0" encoding="utf-8"?>
<!-- canPerformGestures: taps and swipes from the console. canRetrieveWindowContent:
     to find the field that has focus, for typed text. The events asked for are
     the device's activity timeline: which app comes to the front, and that text
     was typed (never a password's text). What is on the screen still reaches the
     console only as pixels, with the holder's consent; these events are the
     context recorded beside them, so an auditor reads what happened. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/input_service_description"
    android:notificationTimeout="100" />
