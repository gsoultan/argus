{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": { "~/*": ["./src/*"] }
  },
  // Application code only.
  //
  // The tooling program below needs @types/node, and TypeScript loads a types
  // package whole: once anything references `node:http`, `process` and `Buffer`
  // become globals for every file in that program. With e2e and the configs in
  // here, `process.env.HOME` in a route typechecked clean — code that would be
  // undefined in a browser. Two programs keeps Node's surface where Node runs.
  "include": ["src"]
}
