{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "paths": { "~/*": ["./src/*"] }
  },
  // Everything, including the plain-JavaScript Node scripts under e2e/.
  //
  // A syntax error in e2e/helpers.ts once passed `bun run typecheck` untouched
  // and surfaced only as Playwright collecting zero tests, because this listed
  // `src` alone. checkJs covers authstub.mjs and preview-monolith.mjs too —
  // they are small, they are load-bearing for the sign-in and cascade suites,
  // and nothing else was reading them.
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
