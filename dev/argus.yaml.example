listen: "127.0.0.1:2222"
host_key: "keys/gateway_host"
authorized_keys: "authorized_keys"
inventory: "inventory.json"
host_key_store: "data/hostkeys.json"
recording_dir: "data/recordings"
# Development only: the target was just built, so nothing has pinned its key
# yet. Production pins out of band and leaves this off.
trust_on_first_use: true
log_level: "debug"

rate_limit:
  connections_per_minute: 6
  burst: 3

ca:
  key_path: "keys/argus_ca"
  validity: 2m

control:
  url: "https://localhost:8480"
  ca_file: "certs/ca.crt"
  cert_file: "certs/client.crt"
  key_file: "certs/client.key"
  token: "reporter-secret"
  spool: "data/report-spool.jsonl"

web:
  listen: "127.0.0.1:8081"
  allowed_origins:
    - "localhost:5290"
    - "127.0.0.1:5290"
  signing_secret: "${ARGUS_SIGNING_SECRET}"
  tls:
    cert_file: "certs/server.crt"
    key_file: "certs/server.key"

storage:
  endpoint: "127.0.0.1:9000"
  access_key: "${ARGUS_S3_ACCESS_KEY}"
  secret_key: "${ARGUS_S3_SECRET_KEY}"
  bucket: "argus-recordings"
  use_ssl: false
