listen: "0.0.0.0:8480"
database_url: "postgres://argus:argus@localhost:5433/argus?sslmode=disable"
allowed_origins:
  - "http://localhost:5290"
  - "http://127.0.0.1:5290"
# Static console tokens: a bootstrap hatch for a deployment with no other way
# in. The control plane refuses to start if these are set once any local
# account exists, because a string in a config file must not stand in for a
# password and a second factor.
#
# Create a real account instead:  argus-control users add you@example.com --role admin
#
# user_tokens:
#   dev-token: "dewi.p@northwind.id"
reporter_token: "${ARGUS_REPORTER_TOKEN}"
agent_stale_after: 90s
log_level: "info"

storage:
  endpoint: "127.0.0.1:9000"
  access_key: "${ARGUS_S3_ACCESS_KEY}"
  secret_key: "${ARGUS_S3_SECRET_KEY}"
  bucket: "argus-recordings"
  use_ssl: false

signing_secret: "${ARGUS_SIGNING_SECRET}"
console_url: ""
session_ttl: 8h
ticket_ttl: 60s

tls:
  cert_file: "certs/server.crt"
  key_file: "certs/server.key"
  # Reporter endpoints additionally require a client certificate signed by this
  # CA, so a leaked reporter token is not sufficient on its own.
  client_ca_file: "certs/ca.crt"

rate_limit:
  login_per_minute: 6
  failures_per_hour: 4
  tickets_per_minute: 10
