listen: "0.0.0.0:8080"
database_url: "postgres://argus:argus@localhost:5433/argus?sslmode=disable"
allowed_origins:
  - "http://localhost:5273"
  - "http://127.0.0.1:5273"
user_tokens:
  dev-token: "dewi.p@northwind.id"
reporter_token: "${ARGUS_REPORTER_TOKEN}"
agent_stale_after: 90s
log_level: "info"

storage:
  endpoint: "127.0.0.1:9000"
  access_key: "${ARGUS_S3_ACCESS_KEY}"
  secret_key: "${ARGUS_S3_SECRET_KEY}"
  bucket: "argus-recordings"
  use_ssl: false

signing_secret: "${ARGUS_SIGNING_SECRET}"
console_url: ""
secure_cookies: false
session_ttl: 8h
ticket_ttl: 60s

oidc:
  issuer: "http://127.0.0.1:5556/dex"
  client_id: "argus-console"
  client_secret: "${ARGUS_OIDC_CLIENT_SECRET}"
  redirect_url: "http://localhost:5273/auth/callback"
  role_claim: "groups"
  default_role: "auditor"
  role_map:
    argus-admins: "admin"
    engineering: "operator"
    authors: "operator"
