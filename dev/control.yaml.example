listen: "0.0.0.0:8080"
database_url: "postgres://argus:argus@localhost:5433/argus?sslmode=disable"
allowed_origins:
  - "http://localhost:5273"
  - "http://127.0.0.1:5273"
user_tokens:
  dev-token: "dewi.p@northwind.id"
reporter_token: "${ARGUS_REPORTER_TOKEN}"
agent_stale_after: 90s
log_level: "info"

storage:
  endpoint: "127.0.0.1:9000"
  access_key: "${ARGUS_S3_ACCESS_KEY}"
  secret_key: "${ARGUS_S3_SECRET_KEY}"
  bucket: "argus-recordings"
  use_ssl: false

signing_secret: "${ARGUS_SIGNING_SECRET}"
console_url: ""
session_ttl: 8h
ticket_ttl: 60s

# Single sign-on, optional.
#
# Argus holds its own accounts, so nothing here is needed to sign in -- create
# the first one with `argus-control users add you@example.com --role admin` and
# use the console's password form. Uncomment this only to federate with an
# identity provider you already run; the sign-in screen then offers both.
#
# oidc:
#   issuer: "https://id.example.com"
#   client_id: "argus-console"
#   client_secret: "${ARGUS_OIDC_CLIENT_SECRET}"
#   redirect_url: "https://argus.example.com/auth/callback"
#   role_claim: "groups"
#   # The least privileged role, so an unmapped group fails closed.
#   default_role: "auditor"
#   role_map:
#     argus-admins: "admin"
#     engineering: "operator"

tls:
  cert_file: "certs/server.crt"
  key_file: "certs/server.key"
  # Reporter endpoints additionally require a client certificate signed by this
  # CA, so a leaked reporter token is not sufficient on its own.
  client_ca_file: "certs/ca.crt"

rate_limit:
  login_per_minute: 6
  failures_per_hour: 4
  tickets_per_minute: 10
