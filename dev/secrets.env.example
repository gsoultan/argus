# Development secrets, sourced by scripts/dev.sh. Gitignored.
# Production supplies these from a secret manager or mounted files.
# Generate with: openssl rand -base64 48
# A placeholder here is refused at startup -- it would sign every session
# cookie and terminal ticket with a value anyone can read in this repo.
export ARGUS_SIGNING_SECRET="CHANGE-ME"
export ARGUS_REPORTER_TOKEN="CHANGE-ME"
export ARGUS_S3_ACCESS_KEY="CHANGE-ME"
export ARGUS_S3_SECRET_KEY="CHANGE-ME"
