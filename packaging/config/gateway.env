# Secrets for argus-gateway, read by systemd. Installed 0600 root:argus.
#
# Every value the config file references with ${VAR} must appear here, or the
# service refuses to start rather than running with an empty credential.
ARGUS_SIGNING_SECRET=CHANGE-ME-at-least-32-characters-long
ARGUS_REPORTER_TOKEN=CHANGE-ME
