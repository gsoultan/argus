[Unit]
Description=Argus secrets server
Documentation=https://github.com/gsoultan/argus
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=argus-secret
Group=argus-secret
ExecStart=/usr/bin/argus-secret --config /etc/argus-secret/secret.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# ── Hardening ────────────────────────────────────────────────────────────────
# This process holds the only key that opens the organization's secrets. It
# gets a database directory and the network, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native
# No core dumps: they would hold unwrapped keys. (argus-secret also marks
# itself non-dumpable.)
LimitCORE=0
# The root key sealed to this host's TPM, decrypted by systemd at start into
# $CREDENTIALS_DIRECTORY and never written to disk in the clear. Uncomment
# after creating it (see secret.example.yaml); systemd refuses to start the
# service while the credential is missing.
#LoadCredentialEncrypted=argus-secret-root-key
UMask=0077

ReadWritePaths=/var/lib/argus-secret

[Install]
WantedBy=multi-user.target
