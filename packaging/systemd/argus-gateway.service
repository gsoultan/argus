[Unit]
Description=Argus SSH gateway
Documentation=https://github.com/gsoultan/argus
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=argus
Group=argus
ExecStart=/usr/bin/argus-gateway --config /etc/argus/gateway.yaml
Restart=on-failure
RestartSec=5s

EnvironmentFile=-/etc/argus/gateway.env

# The gateway holds session plaintext in memory and, in certificate mode, a CA
# key that mints credentials for every host trusting it. Treat it accordingly.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Listens on 2222 and 8081, both above 1024, so no capability is required. If
# you move it to port 22, add CAP_NET_BIND_SERVICE here rather than running it
# as root.
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native

ReadWritePaths=/var/lib/argus

[Install]
WantedBy=multi-user.target
