[Unit]
Description=Argus host agent (session recording collector)
Documentation=https://github.com/gsoultan/argus
# sshd invokes the recorder shim for every session, and the shim refuses the
# connection when the collector is unreachable. Starting before sshd means a
# reboot never leaves a window where sessions are refused for the wrong reason.
Before=sshd.service ssh.service
After=network.target

[Service]
Type=exec
ExecStart=/usr/bin/argus-agent daemon \
    --shim /usr/bin/argus-agent \
    --socket /run/argus/collector.sock \
    --recordings /var/lib/argus/recordings \
    --state /var/lib/argus
Restart=always
RestartSec=2s

# Longer than the collector's own drain (30s) plus its seal grace (10s), so
# systemd never SIGKILLs it part-way through shutting down.
#
# The agent seals recordings on exit. A SIGKILL here leaves every recording
# that was still open with no chain head, unverifiable -- and on a fleet an
# upgrade would do that to every host with someone logged in.
TimeoutStopSec=75s

EnvironmentFile=-/etc/argus/agent.env

# ── Runs as root, deliberately ───────────────────────────────────────────────
# The shim runs as whoever connected. If the daemon were not root, the recorded
# user could read or edit the record of their own session and the whole thing
# would be theatre. Root ownership of the recording is the security argument for
# splitting the agent in two.
#
# So instead of dropping privilege, it drops everything root does not need.
User=root
Group=root

NoNewPrivileges=yes
ProtectSystem=strict
# NOT ProtectHome=yes: the posture scan reads /home/*/.ssh/authorized_keys to
# find standing credentials that could bypass Argus. Read-only is exactly
# the access it needs and no more.
ProtectHome=read-only
PrivateTmp=yes
# The X servers' sockets, for screen sharing, through the private /tmp. An X
# server also listens where no /tmp can hide it (the abstract socket), but
# not every one does. Optional: a server with no X has no such directory.
BindReadOnlyPaths=-/tmp/.X11-unix
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=no

# Reporting to the control plane, plus the local unix socket the shim uses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Reading another user's authorized_keys needs DAC_READ_SEARCH. Loading the
# exec probe (kernel-observed commands) needs BPF and PERFMON, on kernels 5.8
# and later; an older kernel refuses it and the agent records at PTY fidelity
# and says so. Nothing else is retained.
#
# Screen sharing runs its helper as the person signed in at the screen, not
# as root, so a helper talking to their X server can touch nothing of the
# agent's (the recordings above all): changing to their user is SETUID and
# SETGID, which the helper loses, with every other capability, as it does.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON

# bpf and perf_event_open are outside @system-service, and the probe needs both:
# without them the kernel killed the agent at its first bpf() call, before it
# ever reported. A syscall the filter still refuses fails with EPERM instead of
# killing the process -- a dead agent is not a safer agent, it is one that makes
# sshd refuse every login on the host.
SystemCallFilter=@system-service bpf perf_event_open
SystemCallFilter=~@swap @reboot @obsolete
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

RuntimeDirectory=argus
RuntimeDirectoryMode=0755
# Kept across a restart: an update leaves a marker here that tells SSH logins
# arriving mid-restart to wait for the new agent rather than be refused.
RuntimeDirectoryPreserve=restart
StateDirectory=argus
StateDirectoryMode=0700
ReadWritePaths=/var/lib/argus /run/argus

[Install]
WantedBy=multi-user.target
