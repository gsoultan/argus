# Dependencies
node_modules/
.pnp.*

# Build output
dist/
bin/
*.tsbuildinfo

# Vite / TanStack Router
.vite/
web/dev-dist/

# Local config — never commit real credentials or CA material
.env
.env.local
.env.*.local
*.pem
*.key
!**/testdata/
# Vaulted credentials. The whole point is that these never sit in a file
# everybody reads, and a repository is the widest-read file there is.
dev/vault/*.key

# Argus local state
.argus/
recordings/

# Tooling
.gstack/
.serena/cache/
graphify-out/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Gateway dev material — keys and recordings must never be committed
dev/keys/
dev/data/
# Vaulted credentials. The whole point is that these never sit in a file
# everybody reads, and a repository is the widest-read file there is.
dev/vault/
# Spools and recordings written when a service is run from the repo root.
data/
# Vaulted credentials. The whole point is that these never sit in a file
# everybody reads, and a repository is the widest-read file there is.
dev/vault/

# Local configuration carries real secrets; commit the .example templates only.
dev/*.yaml
!dev/*.yaml.example
dev/dex/config.yaml
dev/certs/
dev/secrets.env
!dev/secrets.env.example
dist/
backups/

# Binaries built in the repo root.
#
# `go build ./cmd/...` drops its output beside the source unless told otherwise,
# and two of these were committed by accident — 20 MB of build artefact that
# every clone since has been paying for. Builds belong in bin/, which is already
# ignored; these patterns are anchored to the root so a source directory of the
# same name is unaffected.
/argus-agent
/argus-control
/argus-gateway
/argus-verify
/mintticket
/gencerts
/rdpclient
/rdpprobe
/wsprobe
public/big.cast

# Playwright output
web/test-results/
web/playwright-report/

# Playwright writes here if run from the wrong directory
test-results/
playwright-report/
